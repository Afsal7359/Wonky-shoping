<div class="page">
    <div class="page-main">

        

      

        <!--app-content open-->
        <div class="app-content main-content mt-0">
            <div class="side-app">

                <!-- CONTAINER -->
                <div class="main-container container-fluid">

                        
                    <!-- PAGE-HEADER -->
                    <div class="page-header">
                        <div>
                            <h1 class="page-title">Home Page</h1>
                        </div>
                        <div class="ms-auto pageheader-btn">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="javascript:void(0);">Home Page</a></li>
                                <li class="breadcrumb-item active" aria-current="page">feature Collections</li>
                            </ol>
                        </div>
                    </div>
                    <!-- PAGE-HEADER END -->

                   
                   

                   

                    <!-- row -->
                    <div class="row">
                        <div class="col-lg-6 col-md-6">
                            <div class="card">
                                <div class="card-header border-bottom">
                                    <h3 class="card-title"> Featured Collections</h3>
                                </div>
                                <div class="card-body">
                                    <p class="text-muted"></p>
                                    <!-- Check if there are less than 3 banners before enabling the "Add" button -->
                            
                               
                                
                                    <!-- Display a message or modal to inform the user that they can't add more banners -->
                                    <!-- <p style="color: red;">You have reached the maximum item limit. If you want to add more items, you must delete something below.</p> -->
                                
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /row -->

              <!-- Row -->
              <%if (Data) { %>
            <div class="row">
                <div class="row row-sm">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-header border-bottom">
                                <h3 class="card-title">feature Datatable</h3>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="editable-responsive-table" class="table editable-table table-nowrap table-bordered table-edit wp-100">
                                        <thead>
                                            <tr>
                                                <th>Code</th>
                                                <th>Name</th>
                                                <th>Image</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% for (let i = 0; i < Data.length; i++) { %>
                                                <% let item = Data[i]; %>
                                        
                                            <tr>
                                            
                                                    <td><%= item.Product.code%></td>
                                                    <td><%= item.Product.name%></td>
                                                    <td><%= item.Product.description %></td>
                                                    <td>
                                                        <% if (item.Product.image && item.Product.image.length > 0) { %>
                                                            <% item.Product.image.forEach((image, index) => { %>
                                                                <img src="<%= image %>" style="height: 3em;" alt="Product Image <%= index + 1 %>">
                                                            <% }) %>
                                                        <% } else { %>
                                                            No images available
                                                        <% } %>
                                                    </td>
                                                    <td>
                                                        <div class="card-body">
                                                            <p class="text-muted"></p>
                                                            <!-- <a  class="btn btn-success" data-bs-target="#modaldemo2_<%= i %>" data-bs-toggle="modal">Edit</a> -->
                                                        <!-- data-bs-target="#modaldemo3_<%= i %>" data-bs-toggle="modal">Delete</a> -->
                                                        <!-- <a class="btn btn-primary">   <button class="btn btn-danger" onclick="confirmDelete()">Delete</button></a> -->
                                                        <a href="#" class="btn btn-danger" data-bs-target="#modaldemo3_<%= i %>" data-bs-toggle="modal">Remove From Cotton Collection </a>
                                                            
                                                    
                                                        </div> 
                                                        
                                                        
                                                    </td>
                                            
                                            </tr>
                                            <% } %>
                                            
                                            
                                        
                                                
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Row -->
            <% } else { %>
                <h1 style="color: red;">Table not found</h1>
            <% } %>
       
                   

                    
                </div>
            </div>
        </div>
            <!-- CONTAINER CLOSED -->
     </div>






     <!-- Editmodal -->
     <% for (let i = 0; i < Data.length; i++) { %>
        <% let item = Data[i]; %>
  



        <!-- Delete Modal -->
        <div id="modaldemo3_<%= i %>" class="modal fade">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                   
                    <div class="modal-body">
                        <div class="modal-header" >
                            <h5 class="modal-title" id="exampleModalLabel">Confirm</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                            </button>
                           </div>
                           <div class="modal-body">
                            <p>Are you sure you want to delete?</p>
                          </div>
                          <div class="modal-footer">
                           <button type="button" class="btn btn-secondary" id="close-modal">No</button>
                            <a href="delete-Featured/<%= item._id %>"  class="btn btn-danger" type="button">Yes</a>
                           </div>
                
                </div><!-- modal-content -->
            </div><!-- modal-dialog -->
        </div>
       </div>
    
        <!-- Delete Modal Close -->


    <% } %>

</div>
<script>
    function updateImagePreview(input,imageId ) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById(imageId).src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }


   

</script>